# Apache / LiteSpeed config for reg.ru shared hosting.
# Lives in the site root (Vite copies public/.htaccess → dist/.htaccess, which
# is what you upload). This is the REAL host config — netlify.toml is not used.

Options -MultiViews
DirectorySlash Off
RewriteEngine On
RewriteBase /

# ---- Force HTTPS (works behind reg.ru's SSL-terminating proxy too) ----
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Host consolidation: www → non-www (real 301; Yandex retired the robots
#      "Host:" directive in 2018, so a redirect is required) ----
RewriteCond %{HTTP_HOST} ^www\.melty-cafe\.ru [NC]
RewriteRule ^ https://melty-cafe.ru%{REQUEST_URI} [L,R=301]

# ---- Serve the build-time prerendered route HTML at its clean (no trailing
#      slash) URL so it matches the rel=canonical tags (e.g. /menu, not /menu/).
#      Without DirectorySlash Off, Apache would 301 /menu → /menu/. ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# ---- SPA fallback for any other path that isn't a real file/dir ----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ---- Security headers (Yandex.Webmaster security advisor + hardening) ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Correct MIME types (older Apache builds may miss these) ----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Gzip / deflate ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Caching. Hashed /assets/* are immutable for a year; data images a month;
#      HTML stays short so prerender/content updates show up promptly. ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
